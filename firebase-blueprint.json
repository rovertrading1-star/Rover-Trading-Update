{
  "entities": {
    "User": {
      "title": "User",
      "description": "Student or Admin member profile for Rover Trading",
      "type": "object",
      "properties": {
        "accountNumber": {
          "type": "string",
          "description": "Unique student identifier like RT10001",
          "maxLength": 16
        },
        "firstName": {
          "type": "string",
          "description": "First name of member",
          "maxLength": 60
        },
        "lastName": {
          "type": "string",
          "description": "Surname of member",
          "maxLength": 60
        },
        "email": {
          "type": "string",
          "description": "Email address of member",
          "maxLength": 120
        },
        "cellNumber": {
          "type": "string",
          "description": "Contact telephone number",
          "maxLength": 30
        },
        "paymentStatus": {
          "type": "string",
          "description": "Payment and enrollment status (paid, unpaid, under_review)",
          "enum": ["paid", "unpaid", "under_review"]
        },
        "role": {
          "type": "string",
          "description": "User permission role",
          "enum": ["student", "admin"]
        },
        "password": {
          "type": "string",
          "description": "User credential password for cross-device authentication",
          "maxLength": 128
        },
        "enrolledCourse": {
          "type": "string",
          "description": "Currently enrolled course",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp when account was created"
        }
      },
      "required": ["accountNumber", "firstName", "lastName", "email", "paymentStatus", "role"]
    },
    "Review": {
      "title": "Review",
      "description": "Verified student feedback on the course",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Student name",
          "maxLength": 60
        },
        "course": {
          "type": "string",
          "description": "Completed course title",
          "maxLength": 100
        },
        "rating": {
          "type": "number",
          "description": "Rating out of 5 stars"
        },
        "text": {
          "type": "string",
          "description": "Review testimonial content",
          "maxLength": 600
        },
        "hidden": {
          "type": "boolean",
          "description": "Whether the comment is hidden from public display"
        },
        "status": {
          "type": "string",
          "description": "Moderation status (visible, hidden, flagged)",
          "enum": ["visible", "hidden", "flagged"]
        },
        "moderationReason": {
          "type": "string",
          "description": "Reason for moderation or inappropriate content flag",
          "maxLength": 200
        },
        "date": {
          "type": "string",
          "description": "Timestamp when review was created"
        }
      },
      "required": ["name", "course", "rating", "text"]
    },
    "Application": {
      "title": "Application",
      "description": "Course application and Proof of Payment submission",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Application ID"
        },
        "userId": {
          "type": "string",
          "description": "Student user ID"
        },
        "accountNumber": {
          "type": "string",
          "description": "Student Account Number (e.g. RT10001)"
        },
        "studentName": {
          "type": "string",
          "description": "Full name of applicant"
        },
        "studentEmail": {
          "type": "string",
          "description": "Applicant email"
        },
        "studentPhone": {
          "type": "string",
          "description": "Applicant telephone / WhatsApp"
        },
        "course": {
          "type": "string",
          "description": "Selected course name"
        },
        "coursePrice": {
          "type": "number",
          "description": "Price in ZAR"
        },
        "status": {
          "type": "string",
          "description": "Application status",
          "enum": ["pending_payment", "under_review", "accepted", "declined"]
        },
        "popReference": {
          "type": "string",
          "description": "EFT payment reference code"
        },
        "popDate": {
          "type": "string",
          "description": "Date of payment"
        },
        "popAttachment": {
          "type": "string",
          "description": "Base64 data URI of POP receipt image or PDF"
        },
        "popAttachmentType": {
          "type": "string",
          "description": "Type of POP receipt (image or pdf)"
        },
        "popAttachmentName": {
          "type": "string",
          "description": "Filename of POP receipt"
        },
        "submittedAt": {
          "type": "string",
          "description": "Submission timestamp"
        },
        "reviewedAt": {
          "type": "string",
          "description": "Review timestamp"
        },
        "reviewerNotes": {
          "type": "string",
          "description": "Notes from reviewing administrator"
        }
      },
      "required": ["id", "userId", "studentName", "course", "status"]
    },
    "LearningContent": {
      "title": "LearningContent",
      "description": "Proprietary course curriculum handbook and PDF documents",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Document ID (master_curriculum)"
        },
        "title": {
          "type": "string",
          "description": "Curriculum title"
        },
        "subtitle": {
          "type": "string",
          "description": "Curriculum subtitle"
        },
        "docType": {
          "type": "string",
          "description": "Format of learning content",
          "enum": ["rich_text", "pdf"]
        },
        "pdfDataUrl": {
          "type": "string",
          "description": "Base64 data URI of the PDF curriculum document"
        },
        "pdfFileName": {
          "type": "string",
          "description": "Filename of the uploaded PDF"
        },
        "pdfFileSize": {
          "type": "string",
          "description": "Human-readable size of the PDF"
        },
        "lastUpdated": {
          "type": "string",
          "description": "Last update timestamp"
        },
        "updatedBy": {
          "type": "string",
          "description": "Admin who published the document"
        }
      },
      "required": ["id", "title"]
    },
    "ZoomMeeting": {
      "title": "ZoomMeeting",
      "description": "Interactive live Zoom session schedule",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Meeting ID"
        },
        "topic": {
          "type": "string",
          "description": "Class topic"
        },
        "scheduleDate": {
          "type": "string",
          "description": "Scheduled days"
        },
        "scheduleTime": {
          "type": "string",
          "description": "Class time in SAST"
        },
        "zoomUrl": {
          "type": "string",
          "description": "Direct Zoom link"
        },
        "meetingId": {
          "type": "string",
          "description": "Zoom Meeting ID"
        },
        "passcode": {
          "type": "string",
          "description": "Passcode"
        },
        "status": {
          "type": "string",
          "description": "active or inactive"
        }
      },
      "required": ["id", "topic", "zoomUrl"]
    },
    "ProgressReport": {
      "title": "ProgressReport",
      "description": "Individual student progress milestones and evaluation",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Student user ID"
        },
        "accountNumber": {
          "type": "string",
          "description": "Student Account Number"
        },
        "studentName": {
          "type": "string",
          "description": "Student Name"
        },
        "overallProgress": {
          "type": "number",
          "description": "Percentage completed 0-100"
        },
        "chaptersCompleted": {
          "type": "array",
          "description": "Array of completed chapter numbers"
        },
        "instructorEvaluation": {
          "type": "string",
          "description": "Feedback notes from instructor"
        },
        "lastUpdated": {
          "type": "string",
          "description": "Last evaluation timestamp"
        }
      },
      "required": ["userId", "overallProgress"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Member profile documents keyed by user ID"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Published student reviews and testimonials"
    },
    "/applications/{applicationId}": {
      "schema": "Application",
      "description": "Student course applications and POP submissions"
    },
    "/learning_content/{docId}": {
      "schema": "LearningContent",
      "description": "Proprietary student curriculum documents and PDF"
    },
    "/zoom_meetings/{meetingId}": {
      "schema": "ZoomMeeting",
      "description": "Live scheduled Zoom masterclasses"
    },
    "/progress_reports/{reportId}": {
      "schema": "ProgressReport",
      "description": "Student progress tracking and evaluations"
    }
  }
}
